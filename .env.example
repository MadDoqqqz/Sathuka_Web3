# CryptoPulse Intelligence Environment Variables Configuration Example
# Copy to .env for local overrides. Never commit actual secret tokens.

# Server & Hosting
PORT=3000
NODE_ENV=development
APP_URL="https://your-domain.com"

# Google Gemini AI SDK (Automated quantitative synthesis and news impact evaluation)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# PostgreSQL / TimescaleDB Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/cryptopulse"

# Market Data Providers (Optional API keys for elevated rate limits; public endpoints work out-of-the-box)
BINANCE_API_KEY="YOUR_BINANCE_API_KEY_OPTIONAL"
BINANCE_API_SECRET="YOUR_BINANCE_API_SECRET_OPTIONAL"
COINGECKO_API_KEY="YOUR_COINGECKO_API_KEY_OPTIONAL"

# US Spot ETF Ingestion Adapter
SEC_EDGAR_USER_AGENT="CryptoPulseResearch admin@cryptopulse.io"

# Stripe Subscription Billing (Sandbox or Live)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Notification Channels
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_OPTIONAL"
SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY_OPTIONAL"
